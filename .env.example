# ==========================================================================
# CONTOH PENGATURAN — Posyandu Mawar 1
# Salin file ini menjadi ".env" (cp .env.example .env), lalu isi bagian yang
# bertanda [ISI SENDIRI] sesuai laptop masing-masing. File .env TIDAK di-commit.
# ==========================================================================

APP_NAME="Posyandu Mawar 1"
APP_ENV=local
# [ISI SENDIRI] Jangan diketik manual — jalankan: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# [SESUAIKAN] Alamat saat dibuka di browser, mis. http://127.0.0.1:8000 (php artisan serve)
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: WAJIB MySQL (proposal Tabel 3.2). Jangan pakai sqlite. ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# [SESUAIKAN] Port MySQL di laptop masing-masing (bawaan MySQL 3306; Laragon tertentu memakai 3310)
DB_PORT=3310
# [SESUAIKAN] Buat dulu database kosong dengan nama ini (mis. lewat HeidiSQL/phpMyAdmin Laragon)
DB_DATABASE=posyandu_mawar1
# [SESUAIKAN] Pengguna & [ISI SENDIRI] kata sandi MySQL di laptop masing-masing (Laragon bawaan: root, sandi kosong)
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Akun kader awal (dibuat oleh: php artisan migrate:fresh --seed) ---
# [ISI SENDIRI] Username & kata sandi untuk login pertama (sandi minimal 8 karakter). Jangan dibagikan.
KADER_AWAL_USERNAME=
KADER_AWAL_PASSWORD=
KADER_AWAL_NAMA="Kader Posyandu Mawar 1"

# --- Pengaman login ---
LOGIN_MAKS_PERCOBAAN=5
LOGIN_DURASI_KUNCI_DETIK=60
LOGIN_MAKS_PER_IP_PER_MENIT=20
# Alamat halaman login kader, mis. masuk-kader (bawaan: login → http://.../login)
LOGIN_PATH=login

# --- Identitas posyandu (kop Excel Rekapitulasi & halaman publik) ---
POSYANDU_NAMA="Posyandu Mawar 1"
POSYANDU_NAMA_SINGKAT="Mawar 1"
POSYANDU_DUSUN_RT_RW=Tegalyoso
POSYANDU_DESA=Banyuraden
POSYANDU_KECAMATAN=Gamping
# Halaman publik (isian kosong tidak ditampilkan)
POSYANDU_WILAYAH="Tegalyoso, Banyuraden, Gamping, Sleman"
POSYANDU_JADWAL="Dilaksanakan setiap bulan."
POSYANDU_JAM=
POSYANDU_ALAMAT="Tegalyoso, Banyuraden, Kecamatan Gamping, Kabupaten Sleman, DI Yogyakarta"
POSYANDU_NARAHUBUNG=
POSYANDU_TELEPON=
PUBLIK_CACHE_DETIK=600
PUBLIK_MAKS_PER_MENIT=60

# --- Manajemen Pengguna: tolak kata sandi yang pernah bocor (butuh internet; dilewati bila tidak terhubung) ---
PENGGUNA_CEK_SANDI_BOCOR=true
